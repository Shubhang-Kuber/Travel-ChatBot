# Static TravelBot UI + same-origin proxy to the FastAPI backend (no CORS needed).
# ${BACKEND_URL} is filled in by the nginx image's envsubst at container start.
server {
    listen 8501;
    root /usr/share/nginx/html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # /api/chat/stream -> ${BACKEND_URL}/chat/stream
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        # Server-Sent Events: forward tokens as they arrive.
        proxy_buffering off;
        proxy_cache off;
        # plan -> retrieve -> grade -> generate can take a while.
        proxy_read_timeout 300s;
    }
}
