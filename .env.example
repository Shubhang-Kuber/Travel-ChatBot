# WanderChat backend configuration. Copy to .env (gitignored) and fill in JWT_SECRET:
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Every variable read by backend/config.py is listed here. Blank values fall back to the
# default shown in the comment, EXCEPT JWT_SECRET, which is required.

# ---- Auth ------------------------------------------------------------------------------
# REQUIRED, at least 32 characters. Never commit a real value. Generate one with:
#
#   PowerShell (cryptographic RNG, 48 random bytes, URL-safe base64):
#     $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')
#
#   Docker (no local Python needed; works from PowerShell or bash):
#     docker run --rm python:3.12.16-slim-trixie python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it invalidates every issued access and refresh token (everyone logs in again).
JWT_SECRET=
# Access token lifetime in minutes (default 15).
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime in days (default 7).
REFRESH_TOKEN_TTL_DAYS=7

# ---- MongoDB ---------------------------------------------------------------------------
# Leave commented to use the compose `mongo` service:
#   mongodb://mongo:27017/?directConnection=true
# Set it only to point the backend at another instance (e.g. an Atlas cluster URI).
# Do NOT set it to localhost here: inside the backend container, localhost is the
# container itself, not your machine.
# MONGO_URI=
# Database name (default wanderchat). One database for everything (travel_tips + users).
MONGO_DB=wanderchat
# How long startup keeps retrying the first Mongo ping before failing (default 30).
MONGO_STARTUP_TIMEOUT_SECONDS=30

# ---- Travel data: MongoDB Atlas (data/search.py, mongo/load_mongo.py) -------------------
# Atlas connection string holding the `posts` + `chunks` collections and their search indexes.
# Separate from MONGO_URI above (that is the backend's own Mongo for users).
# Keep the double quotes: the string contains ? and &.
#   MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URI=""
# Database holding posts + chunks (default travel).
TIPS_DB=travel

# ---- Embeddings: Ollama + nomic-embed-text (every chat question is embedded) -------------
# Starts the compose `ollama` service and pulls the model on first start (~3 GB disk, no GPU
# needed). To use an Ollama installed natively on your machine instead, delete this line and set
# DOCKER_EMBED_HOST below.
COMPOSE_PROFILES=ollama
# Where the backend CONTAINER finds Ollama (default http://ollama:11434, the compose service).
# Native Ollama on your machine: DOCKER_EMBED_HOST=http://host.docker.internal:11434
# DOCKER_EMBED_HOST=
# Host port of the compose Ollama; change if a native Ollama already uses 11434.
# OLLAMA_HOST_PORT=11434
# For scripts run by hand on your machine (python -m data.search, preprocessing/embed_chunks.py).
EMBED_HOST=http://localhost:11434
# Must be the model the chunks were embedded with.
EMBED_MODEL=nomic-embed-text
# "user:pass", only if Ollama sits behind ngrok basic auth.
EMBED_AUTH=

# ---- Logging ---------------------------------------------------------------------------
# App log level: DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive, default INFO).
# An invalid value fails startup. Tokens, passwords and message text are never logged.
LOG_LEVEL=INFO

# ---- HTTP ------------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ---- Rate limits: "N/seconds" sliding window --------------------------------------------
# Auth buckets are per client IP; chat is per authenticated user.
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_SIGNUP=5/60
# Shared by /auth/refresh and /auth/logout.
RATE_LIMIT_REFRESH=30/60
RATE_LIMIT_CHAT=30/60

# ---- Graph (Person B's agent) ----------------------------------------------------------
# true: in-process mock graph (no LLM, no API key needed). false: import agent.graph:graph.
USE_MOCK_GRAPH=true
# Mock only: TOTAL blocking delay per call in seconds, to imitate LLM latency (default 0).
# /chat sleeps it once; /chat/stream spreads it evenly across the streamed chunks.
MOCK_GRAPH_DELAY_SECONDS=0
# Graph node whose LLM tokens are streamed to the user (default generate).
STREAM_NODE=generate

# ---- Host ports (docker-compose only; not read by the app) -------------------------------
# Change if something on your machine already uses the port, e.g. a natively installed
# MongoDB Windows service on 27017 ("ports are not available ... bind" on `up`).
# MONGO_HOST_PORT=27017
# BACKEND_HOST_PORT=8000

# ---- LLM -------------------------------------------------------------------------------
# Gemini API key for the real graph. Unused while USE_MOCK_GRAPH=true. Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional live web search fallback (Tavily). Never commit it.
TAVILY_API_KEY=
